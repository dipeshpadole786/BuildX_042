{
  "expo": {
    "name": "Pulse",
    "slug": "pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pulse",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pulse uses your location to dispatch the nearest ambulance and find nearby hospitals."
      }
    },
    "android": {
      "package": "app.pulse.emergency",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pulse uses your location to dispatch the nearest ambulance and find nearby hospitals."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
